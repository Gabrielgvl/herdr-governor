{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "local_shell|shell|shell_command|exec_command|write_stdin|apply_patch|Edit|Write|MultiEdit|Bash|Shell|powershell",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./scripts/agent-gate.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./scripts/fmt-on-edit.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
